<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>org.divinitycraft</groupId>
  <artifactId>DivinityEconomy</artifactId>
  <!-- Experimental hybrid-server (Arclight) build. The jar is DivinityEconomy-4.0.0-arclight.jar -->
  <version>4.0.0-arclight</version>

  <name>DivinityEconomy - The Global Market (Arclight Experimental)</name>
  <url>https://divinitycraft.org</url>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
    <!-- Parallel test JVMs; override with -Dtest.forkCount=1 to run serially. -->
    <test.forkCount>0.5C</test.forkCount>
  </properties>

  <repositories>
    <repository>
      <id>maven-central</id>
      <url>https://oss.sonatype.org/content/groups/public</url>
    </repository>
    <repository>
      <id>placeholderapi</id>
      <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
    </repository>
    <repository>
      <id>spigot-repo</id>
      <url>https://hub.spigotmc.org/nexus/content/groups/public/</url>
    </repository>
    <repository>
      <id>jitpack.io</id>
      <url>https://jitpack.io</url>
    </repository>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
  </repositories>

  <dependencies>
    <!-- Required dependencies -->
    <dependency>
      <groupId>com.tchristofferson</groupId>
      <artifactId>ConfigUpdater</artifactId>
      <version>2.2</version>
    </dependency>
    <dependency>
      <groupId>org.mariuszgromada.math</groupId>
      <artifactId>MathParser.org-mXparser</artifactId>
      <version>6.1.1</version>
    </dependency>

    <!-- Provided dependencies (won't be included in the final JAR) -->
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>3.15.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>me.clip</groupId>
      <artifactId>placeholderapi</artifactId>
      <version>2.12.3</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.github.MilkBowl</groupId>
      <artifactId>VaultAPI</artifactId>
      <version>1.7.1</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.spigotmc</groupId>
      <artifactId>spigot-api</artifactId>
      <version>26.2-R0.1-SNAPSHOT</version>
      <scope>provided</scope>
    </dependency>
    <!-- javax.annotation.Nonnull/Nullable are used throughout the codebase but no other
         dependency actually provides this package; without it a clean build fails. -->
    <dependency>
      <groupId>com.google.code.findbugs</groupId>
      <artifactId>jsr305</artifactId>
      <version>3.0.2</version>
      <scope>provided</scope>
    </dependency>

    <!-- Test dependencies -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>5.18.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <version>5.18.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockbukkit.mockbukkit</groupId>
      <artifactId>mockbukkit-v1.21</artifactId>
      <version>4.108.0</version>
      <scope>test</scope>
    </dependency>
    <!-- Silences "No SLF4J providers were found" by supplying an explicit no-op backend. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>2.0.17</version>
      <scope>test</scope>
    </dependency>
    <!-- MockBukkit's published POM omits its paper-api compileOnly dependency; without it on the
         test classpath, javac fails to resolve type annotations on MockBukkit's own class files
         that reference Paper-only types. -->
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>1.21.11-R0.1-SNAPSHOT</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}-${project.version}</finalName>

    <resources>
      <resource>
        <directory>src/resources</directory>
        <filtering>false</filtering>
        <targetPath>.</targetPath>
      </resource>
      <resource>
        <directory>src/locale</directory>
        <filtering>false</filtering>
        <targetPath>.</targetPath>
      </resource>
    </resources>

    <testResources>
      <testResource>
        <directory>src/resources</directory>
        <filtering>false</filtering>
        <targetPath>.</targetPath>
      </testResource>
      <testResource>
        <directory>src/locale</directory>
        <filtering>false</filtering>
        <targetPath>.</targetPath>
      </testResource>
    </testResources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- MockBukkit sets the static Bukkit server singleton, so tests can't share a JVM
               across threads. Parallelism is therefore done with separate forked JVMs; each
               fork runs test classes one at a time. -->
          <forkCount>${test.forkCount}</forkCount>
          <reuseForks>true</reuseForks>
          <!-- Mockito is loaded as an explicit agent (JDK 21+ no longer self-attaches reliably). -->
          <argLine>-javaagent:${org.mockito:mockito-core:jar} -XX:+UseParallelGC -Xshare:auto --sun-misc-unsafe-memory-access=allow</argLine>
          <!-- MockBukkit is compiled against paper-api, which shares org.bukkit.* package
               names with spigot-api (used at compile time for the plugin itself) but with a
               newer/richer implementation. Having both on the runtime classpath causes the
               wrong (spigot-api, interface-only) class to be loaded and MockBukkit to fail
               with NoSuchMethodError. Excluding spigot-api from the test *runtime* classpath
               only (it's still used for compiling both main and test sources) resolves this,
               since paper-api is a superset and binary-compatible for everything this plugin uses. -->
          <classpathDependencyExcludes>
            <classpathDependencyExclude>org.spigotmc:spigot-api</classpathDependencyExclude>
          </classpathDependencyExcludes>
        </configuration>
      </plugin>

      <!-- Exposes the mockito-core jar path as ${org.mockito:mockito-core:jar} for the agent. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>mockito-agent-path</id>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Maven Shade Plugin to include specific dependencies -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <artifactSet>
                <includes>
                  <include>com.tchristofferson:ConfigUpdater</include>
                  <include>org.mariuszgromada.math:MathParser.org-mXparser</include>
                </includes>
              </artifactSet>

              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.divinitycraft.divinityeconomy.Main</mainClass>
                </transformer>
              </transformers>

              <shadedArtifactAttached>false</shadedArtifactAttached>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
